[
  {
    "id": "s2",
    "text": "見えないと、続かない。",
    "durationSec": 1.7813333333333334,
    "bytes": 85548
  },
  {
    "id": "s3",
    "text": "距離を、地図に変えよう。",
    "durationSec": 1.8133333333333332,
    "bytes": 87084
  },
  {
    "id": "s4_1",
    "text": "国道を選んで登録すれば、あとはいつも通り走るだけ。",
    "durationSec": 3.872,
    "bytes": 185900
  },
  {
    "id": "s4_2",
    "text": "今どこまで来たか、いつでも一目で分かります。",
    "durationSec": 3.0613333333333332,
    "bytes": 146988
  },
  {
    "id": "s5_1",
    "text": "走った距離が、",
    "durationSec": 1.024,
    "bytes": 49196
  },
  {
    "id": "s5_2",
    "text": "そのまま、国道になる。",
    "durationSec": 1.824,
    "bytes": 87596
  },
  {
    "id": "s6_1",
    "text": "日本地図の上に、自分だけの走行の軌跡が刻まれていく。",
    "durationSec": 4.053333333333334,
    "bytes": 194604
  },
  {
    "id": "s6_2",
    "text": "挑戦中はブルー、完走したらゴールドに変わります。",
    "durationSec": 3.530666666666667,
    "bytes": 169516
  },
  {
    "id": "s7_1",
    "text": "目標の日までに、あと何キロ必要か。",
    "durationSec": 2.8053514739229026,
    "bytes": 247510
  },
  {
    "id": "s7_2",
    "text": "逆算ナビがいつも並走してくれます。",
    "durationSec": 2.2933333333333334,
    "bytes": 202350
  }
]